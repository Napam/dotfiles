window-colorspace = srgb
theme = "Kitty Default"

custom-shader = ./shaders/cursor_warp.glsl
custom-shader = ./shaders/sonic_boom_cursor.glsl
custom-shader-animation = always

background = #000000
background-opacity = 0.85
background-blur = 0

font-family = "JetBrainsNerdFont Mono"
font-size = 11

# Ideally don't want any thickening, but they way MacOS renders
# works very bad on bad monitors. Thus have to thicken.
font-thicken = true
font-thicken-strength = 200

macos-option-as-alt = true

# Map Cmd+A to send Meta-A (Alt-A) to match the tmux prefix
keybind = cmd+a=text:\x1ba
# Also have ctrl+ø map to Alt-A for tmux prefix (tmux can only do ASCII input, thus map from terminal)
keybind = ctrl+ø=text:\x1ba
keybind = all:alt+7=text:|
keybind = all:alt+8=text:[
keybind = all:alt+9=text:]
keybind = all:alt+¨=text:~
keybind = all:shift+alt+7=text:\\
keybind = all:shift+alt+8=text:{
keybind = all:shift+alt+9=text:}
keybind = global:ctrl+å=toggle_quick_terminal
