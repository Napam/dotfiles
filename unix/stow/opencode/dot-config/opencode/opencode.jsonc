{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-flash",
  "default_agent": "orchestrator",

  // Inherited by all agents unless overridden. Agent permission blocks merge additively
  // on top — specify only the delta (e.g., orchestrator adds "task").
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
    },
    "external_directory": {
      "/tmp/**": "allow",
      "~/.agents/**": "allow",
      "~/.cache/huggingface/**": "allow",
      "~/.cache/nvim/**": "allow",
      "~/.cache/opencode/**": "allow",
      "~/.cache/uv/**": "allow",
      "~/.cargo/**": "allow",
      "~/.claude/**": "allow",
      "~/.config/**": "allow",
      "~/.go/**": "allow",
      "~/.gradle/**": "allow",
      "~/.local/**": "allow",
      "~/.m2/**": "allow",
      "~/.pub-cache/**": "allow",
      "~/.terraform.d/**": "allow",
    },
    "webfetch": "allow",
  },

  "agent": {
    // Prompts/descriptions in agents/*.md; models defined here (avoids precedence bug with OPENCODE_CONFIG)
    "orchestrator": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "high",
      "permission": {
        "task": { "*": "allow", "general": "deny" },
      },
    },
    // Kinda weird now with low and med, since deepseek v4 is both really cheap and really good
    "low": { "model": "opencode-go/deepseek-v4-flash", "variant": "high" },
    "med": { "model": "opencode-go/deepseek-v4-flash", "variant": "max" },
    "deep": { "model": "opencode-go/deepseek-v4-pro", "variant": "high" },
    "herdr-controller": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "high",
      "permission": { "task": { "*": "deny" } },
    },
    "herdr-worker": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "high",
      "permission": { "task": { "*": "deny" } },
    },
    "build": { "model": "opencode-go/deepseek-v4-flash" },
    "general": { "model": "opencode-go/deepseek-v4-flash" },
    "min": {
      "model": "llama-cpp-local/primary",
      "steps": 8,
      "permission": {
        "task": { "*": "deny" },
        "webfetch": "deny",
        "todowrite": "deny",
        "question": "deny",
      },
    },
  },

  "plugin": [
    "opencode-with-claude@latest",
    "openslimedit@latest",
    "opencode-sentinel",
  ],

  "provider": {
    "anthropic": {
      "options": {
        "baseURL": "http://127.0.0.1:3456",
        "apiKey": "dummy",
      },
    },

    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "local-ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1",
      },
      "models": {
        "primary": { "name": "Local Ollama" },
      },
    },

    "llama-cpp-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "local-llama",
      "options": {
        "baseURL": "http://127.0.0.1:6700",
      },
      "models": {
        "primary": {
          "name": "Local LLama",
        },
      },
    },
  },
}
